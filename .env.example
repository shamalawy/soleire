# Copy to `.env` and edit. `.env` is git-ignored — never commit real secrets.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(64))"   # -> DJANGO_SECRET_KEY

# ---------------------------------------------------------------- Django ---
# Generate your own. Required whenever DJANGO_DEBUG is false.
DJANGO_SECRET_KEY=change-me-generate-a-random-64-character-string

# Never enable in production: leaks settings and tracebacks to visitors.
DJANGO_DEBUG=false

# Comma-separated. Add your real hostname(s) before exposing the site.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, scheme required, e.g. https://soleire.ie
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_LOG_LEVEL=INFO
DJANGO_TIME_ZONE=Europe/Dublin

# Set to true when running behind a TLS-terminating reverse proxy so Django
# trusts X-Forwarded-Proto. This also turns on HTTP-to-HTTPS redirection;
# override with DJANGO_SECURE_SSL_REDIRECT if your proxy already does that.
DJANGO_BEHIND_PROXY=false
# DJANGO_SECURE_SSL_REDIRECT=

# Set to false only for a local production-mode smoke test over plain HTTP —
# otherwise the session cookie is Secure-only and sign-in appears to do nothing.
# DJANGO_SECURE_COOKIES=

# -------------------------------------------------------------- Database ---
POSTGRES_DB=soleire
POSTGRES_USER=soleire
POSTGRES_PASSWORD=change-me-too
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: confine the tables to a named schema instead of `public`.
POSTGRES_SCHEMA=
# Alternatively supply a single URL, which takes precedence over the above:
# DATABASE_URL=postgres://soleire:secret@db:5432/soleire

# ---------------------------------------------------------------- Runtime ---
DJANGO_MIGRATE_ON_START=true
DJANGO_DB_WAIT_TIMEOUT=60

# Optional bootstrap superuser, created on first boot only.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# ------------------------------------------------------------- Statistics ---
# Privacy floor: a county/orientation/size bucket is only published once at
# least this many distinct systems have contributed to it. Raising it makes
# re-identification harder but hides more of the long tail.
SOLEIRE_MIN_GROUP_SIZE=3

# Seconds to cache the public aggregate queries. 0 disables caching entirely.
# The TTL is only a backstop: any new reading retires the cached aggregates
# immediately, so a contributor never sees figures that predate their own
# submission.
SOLEIRE_STATS_CACHE_SECONDS=300

# The cache lives in PostgreSQL by default, shared across gunicorn workers.
# Point this at redis://host:6379/0 on a deployment big enough to want one.
# DJANGO_CACHE_URL=
# Single-process in-memory cache. Only correct under `runserver`; under
# gunicorn each worker gets a private copy and visitors see different numbers.
# DJANGO_CACHE_LOCMEM=false

# ------------------------------------------------------------------- Host ---
# Your host uid/gid, so files written into the dev bind mount stay yours.
# Find them with: id -u ; id -g
DOCKER_UID=1000
DOCKER_GID=1000

WEB_PORT=8000
# Host port the dev override maps Postgres to. Deliberately not 5432:
# most machines that run this already have a local Postgres on that port.
POSTGRES_PORT_HOST=55432
