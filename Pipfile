# Kept in step with requirements.txt, which is what the container image installs.
# Either works locally; the image uses requirements*.txt so the build has a
# small, cache-friendly layer and no pipenv in the runtime.
[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
django = ">=5.2,<5.3"
psycopg = {extras = ["binary"], version = ">=3.2,<4"}
gunicorn = ">=23.0,<24"
whitenoise = {extras = ["brotli"], version = ">=6.7,<7"}
argon2-cffi = ">=23.1"

[dev-packages]
pytest = ">=8.3,<9"
pytest-django = ">=4.9,<5"
coverage = ">=7.6"
ruff = ">=0.7"

[requires]
python_version = "3.12"
